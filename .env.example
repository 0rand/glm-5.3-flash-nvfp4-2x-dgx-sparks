# =============================================================================
# GLM-5.3-Flash NVFP4 (lab quant) on 2x DGX Spark — TP=2 over RoCE
# =============================================================================
# Copy this file to .env, edit for your cluster, then:
#
#   ./download.sh            # base image + checkpoint (both nodes) + build
#   ./start.sh               # sync configs to worker, worker-first launch
#   ./status.sh              # health + boot markers
#   ./stop.sh                # stop both nodes
#
# Recipe: kilork gist a887667f (92/100 tool-eval hardmode, 512K ctx, MTP k=3).
# Site-specific values are marked [EDIT].
# =============================================================================

# --- Docker Image (built by download.sh from ./Dockerfile + patches/) ---
IMAGE=glm53-flash-lab:local

# --- Model ---
MODEL_PATH=local-inference-lab/GLM-5.3-Flash-NVFP4
# Pin: the lab repo moves; download + serve THIS revision on BOTH nodes.
MODEL_REVISION=378ca54585c46542bad1f3cb3ed0d73ae51cdb62
SERVED_MODEL_NAME=glm53-flash

# --- Cache Directories (absolute, per node) ---  [EDIT]
HF_CACHE=/home/<user>/.cache/huggingface

# --- RoCE Network Interfaces ---  [EDIT]
# Find yours: ibstat | grep -E 'CA|hca_id'  and  ip -br addr | grep <roce-subnet>
NCCL_IB_HCA=rocepXsXfX,rocePXpXfX
NCCL_SOCKET_IFNAME=enpXsXfXnpX
CONTROL_IF=enpXsXfXnpX

# --- Cluster IPs (RoCE / backend network) ---  [EDIT]
MASTER_ADDR=192.168.0.1       # head node's RoCE IP — same on both nodes
HEAD_ROCE_IP=192.168.0.1      # head node's own RoCE IP
WORKER_ROCE_IP=192.168.0.2    # worker node's own RoCE IP

# --- SSH (for start.sh to sync configs to the worker) ---  [EDIT]
WORKER_SSH_TARGET=<user>@<worker-roce-or-lan-ip>
# Bulk transfers (rsync, docker save|load) — RoCE subnet, ~300 MB/s
WORKER_ROCE_SSH_TARGET=<user>@<worker-roce-ip>
WORKER_DIR=/home/<user>/dockers/GLM-5.3-Flash-NVFP4-2x-DGX-Sparks

# --- Serving ---
PORT=30000
MASTER_PORT=29500
TP_SIZE=2

# --- Memory (Primo's 2026-08-30 tuning) ---
# MEU drives KV sizing (the gist's --kv-cache-memory-bytes pin is REMOVED —
# they override each other; watch vLLM #48140 if KV sizing looks wrong).
GPU_MEMORY_UTILIZATION=0.86

# --- Context & Throughput ---
MAX_MODEL_LEN=524288          # 512K — smoke-test context
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=1024   # gist: 4096; 8192 OOMs at 512K. 1024 = quality-first.
MTP_TOKENS=3                  # MTP speculative tokens

# --- CPU ---
OMP_NUM_THREADS=4
